<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.sql.*" %><!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Resources · SmartCampus</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/style.css"></head><body><%@ include file="/includes/header.jspf" %><main class="page-shell"><div class="page-title"><div><span class="eyebrow">SPACE TO MAKE THINGS HAPPEN</span><h1>Find your <span class="gradient-text">space.</span></h1><p class="muted">Browse campus resources and send a booking request in a few clicks.</p></div></div><div class="resource-layout"><section class="resource-list"><% ResultSet rs=(ResultSet)request.getAttribute("resources");boolean any=false;while(rs.next()){any=true;%><article class="resource-card"><div class="resource-icon"><%=rs.getString("name").toLowerCase().contains("lab")?"⌘":rs.getString("name").toLowerCase().contains("projector")?"▣":"▦"%></div><div class="resource-main"><span class="tag">CAMPUS RESOURCE</span><h3><%=rs.getString("name")%></h3><p><%=rs.getString("description")%></p><div class="resource-meta"><span>⌖ <%=rs.getString("location")%></span><span>♙ Capacity <%=rs.getInt("capacity")%></span></div></div><button class="btn primary small" onclick="chooseResource(<%=rs.getInt("id")%>, '<%=rs.getString("name").replace("'","\'")%>')">Request booking ↗</button></article><%}if(!any){%><p class="empty-state">No resources available yet.</p><%}%></section><aside class="booking-form-card" id="bookingForm"><span class="eyebrow">BOOK A RESOURCE</span><h2>Make a request.</h2><p class="muted">Choose your date and time. Requests are reviewed by an administrator.</p><form method="post" action="<%=request.getContextPath()%>/book"><label>Selected resource<select id="resourceId" name="resourceId" required><option value="">Choose a resource</option><% ResultSet rr=(ResultSet)request.getAttribute("resourceOptions");while(rr.next()){%><option value="<%=rr.getInt("id")%>"><%=rr.getString("name")%></option><%}%></select></label><label>Date<input type="date" name="bookingDate" required min="<%=java.time.LocalDate.now()%>"></label><div class="form-two"><label>Start time<input type="time" name="startTime" required></label><label>End time<input type="time" name="endTime" required></label></div><label>Purpose<textarea name="purpose" required maxlength="500" rows="3" placeholder="What will you use this resource for?"></textarea></label><button class="btn primary full" type="submit">Submit request ↗</button><small class="form-note">Overlapping time slots are flagged automatically.</small></form></aside></div></main><script>function chooseResource(id,name){document.getElementById('resourceId').value=id;document.getElementById('bookingForm').scrollIntoView({behavior:'smooth',block:'center'})}</script><footer><span>SmartCampus · Resources</span><span>Better spaces, better ideas.</span></footer></body></html>