<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.sql.*" %><!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Events · SmartCampus</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/style.css"></head><body><%@ include file="/includes/header.jspf" %><main class="page-shell"><div class="page-title"><div><span class="eyebrow">CAMPUS CALENDAR</span><h1>Find your <span class="gradient-text">next thing.</span></h1><p class="muted">Workshops, talks, fests and ideas worth showing up for.</p></div></div><div class="toolbar"><input id="eventSearch" type="search" placeholder="Search events or venues…" oninput="filterCards()"><span class="muted">Discover · Connect · Learn</span></div><div class="event-card-grid"><% ResultSet rs=(ResultSet)request.getAttribute("events");boolean any=false;while(rs.next()){any=true;java.sql.Date d=rs.getDate("event_date"); %><article class="event-card searchable"><div class="event-cover cover-<%=Math.abs(rs.getString("category").hashCode())%3%>"><span class="cover-symbol"><%=rs.getString("category").equalsIgnoreCase("Technical")?"⌘":rs.getString("category").equalsIgnoreCase("Cultural")?"✳":"◈"%></span><span class="cover-label"><%=rs.getString("category")%></span></div><div class="event-card-body"><div class="event-date-line"><span>◷ <%=d.toLocalDate()%></span><span>↗ <%=rs.getString("venue")%></span></div><h3><%=rs.getString("title")%></h3><p><%=rs.getString("description")%></p><div class="event-card-bottom"><span class="muted"><%=rs.getInt("registered")%> registered</span><form method="post" action="<%=request.getContextPath()%>/event-register"><input type="hidden" name="eventId" value="<%=rs.getInt("id")%>"><button class="btn small primary" type="submit">Register ↗</button></form></div></div></article><% } if(!any){ %><div class="empty-state">No upcoming events have been added yet. Admins can add events from the admin panel.</div><% } %></div></main><script>function filterCards(){let q=document.getElementById('eventSearch').value.toLowerCase();document.querySelectorAll('.searchable').forEach(c=>c.style.display=c.innerText.toLowerCase().includes(q)?'':'none')}</script><footer><span>SmartCampus · Events</span><span>Find your next favourite thing.</span></footer></body></html>