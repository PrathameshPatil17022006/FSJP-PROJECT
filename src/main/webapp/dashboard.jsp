<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.sql.*" %><!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Dashboard · SmartCampus</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/style.css"></head><body><%@ include file="/includes/header.jspf" %><main class="page-shell"><div class="page-title"><div><span class="eyebrow">YOUR CAMPUS OVERVIEW</span><h1>Hey, <%=session.getAttribute("userName")%> <span>✳</span></h1><p class="muted">Here's what's happening in your campus world.</p></div><a class="btn primary" href="<%=request.getContextPath()%>/resources">+ Book a resource</a></div><div class="metric-grid"><div class="metric-card"><span>EVENT REGISTRATIONS</span><b><%=request.getAttribute("eventCount")%></b><small>Events you're part of</small><span class="metric-icon lilac">✳</span></div><div class="metric-card"><span>PENDING BOOKINGS</span><b><%=request.getAttribute("pendingCount")%></b><small>Awaiting admin approval</small><span class="metric-icon peach">◷</span></div><div class="metric-card"><span>YOUR NEXT STEP</span><b class="metric-word">Explore</b><small>Discover something new</small><span class="metric-icon mint">↗</span></div></div><div class="content-panel"><div class="panel-heading"><div><span class="eyebrow">DON'T MISS OUT</span><h2>Coming up on campus</h2></div><a href="<%=request.getContextPath()%>/events">All events ↗</a></div><div class="event-list"><% ResultSet rs=(ResultSet)request.getAttribute("eventPreview"); boolean any=false; while(rs.next()){any=true; java.sql.Date d=rs.getDate("event_date"); %><article class="event-row"><div class="date-tile"><b><%=d.toLocalDate().getDayOfMonth()%></b><small><%=d.toLocalDate().getMonth().toString().substring(0,3)%></small></div><div class="event-info"><span class="tag"><%=rs.getString("category")%></span><h3><%=rs.getString("title")%></h3><p><%=rs.getString("venue")%> · <%=rs.getTime("start_time")%></p></div><a class="round-link" href="<%=request.getContextPath()%>/events">↗</a></article><% } if(!any){ %><p class="empty-state">No upcoming events yet. Check back soon.</p><% } %></div></div></main><footer><span>SmartCampus · Your dashboard</span><span>Stay curious. Stay connected.</span></footer></body></html>