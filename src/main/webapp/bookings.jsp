<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.sql.*" %><!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>My bookings · SmartCampus</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/style.css"></head><body><%@ include file="/includes/header.jspf" %><main class="page-shell"><div class="page-title"><div><span class="eyebrow">YOUR REQUESTS</span><h1>My <span class="gradient-text">bookings.</span></h1><p class="muted">Track your resource requests and approval status.</p></div><a class="btn primary" href="<%=request.getContextPath()%>/resources">+ New booking</a></div><div class="content-panel"><div class="table-wrap"><table><thead><tr><th>RESOURCE</th><th>DATE</th><th>TIME</th><th>PURPOSE</th><th>STATUS</th></tr></thead><tbody><% ResultSet rs=(ResultSet)request.getAttribute("bookings");boolean any=false;while(rs.next()){any=true;%><tr><td><b><%=rs.getString("resource_name")%></b></td><td><%=rs.getDate("booking_date")%></td><td><%=rs.getTime("start_time")%> – <%=rs.getTime("end_time")%></td><td><%=rs.getString("purpose")%></td><td><span class="status <%=rs.getString("status").toLowerCase()%>"><%=rs.getString("status")%></span></td></tr><%}if(!any){%><tr><td colspan="5" class="empty-state">You haven't requested a booking yet.</td></tr><%}%></tbody></table></div></div></main><footer><span>SmartCampus · My bookings</span><span>All your requests in one place.</span></footer></body></html>