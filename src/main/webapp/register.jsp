<%@ page contentType="text/html;charset=UTF-8" %><!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Create account · SmartCampus</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/style.css"></head><body><%@ include file="/includes/header.jspf" %><main class="auth-wrap"><div class="auth-art"><span class="eyebrow">JOIN YOUR CAMPUS</span><h2>Good things<br>happen <em>here.</em></h2><p>One account brings your events, bookings and campus community together.</p><div class="auth-art-orbit">✦</div></div><form class="auth-card" method="post" action="<%=request.getContextPath()%>/register"><span class="eyebrow">GET STARTED</span><h1>Create account</h1><p class="muted">It only takes a minute.</p><label>Full name<input name="name" required maxlength="100" placeholder="Your full name" autocomplete="name"></label><label>College email<input type="email" name="email" required maxlength="150" placeholder="you@college.edu" autocomplete="email"></label><label>Password<input type="password" name="password" required minlength="8" placeholder="At least 8 characters" autocomplete="new-password"></label><button class="btn primary full" type="submit">Create account <span>↗</span></button><p class="auth-foot">Already registered? <a href="<%=request.getContextPath()%>/login">Sign in</a></p></form></main><footer><span>SmartCampus · Student portal</span><span>Made for campus life</span></footer></body></html>