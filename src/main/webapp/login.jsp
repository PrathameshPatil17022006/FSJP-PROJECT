<%@ page contentType="text/html;charset=UTF-8" %><!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Sign in · SmartCampus</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/style.css"></head><body><%@ include file="/includes/header.jspf" %><main class="auth-wrap"><div class="auth-art"><span class="eyebrow">WELCOME BACK</span><h2>Your campus<br>is all here.</h2><p>Events worth showing up for. Spaces ready when you are.</p><div class="auth-art-orbit">✳</div></div><form class="auth-card" method="post" action="<%=request.getContextPath()%>/login"><span class="eyebrow">STUDENT PORTAL</span><h1>Sign in</h1><p class="muted">Pick up where campus life left off.</p><label>Email address<input type="email" name="email" required placeholder="you@college.edu" autocomplete="email"></label><label>Password<input type="password" name="password" required placeholder="Enter your password" autocomplete="current-password"></label><button class="btn primary full" type="submit">Sign in <span>↗</span></button><p class="auth-foot">New to SmartCampus? <a href="<%=request.getContextPath()%>/register">Create an account</a></p></form></main><footer><span>SmartCampus · Student portal</span><span>Secure sign in</span></footer></body></html>